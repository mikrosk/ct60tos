--- a/gas/config/tc-m68k.c
+++ b/gas/config/tc-m68k.c
@@ -446,6 +446,19 @@
   the_ins.fragb[the_ins.nfrag++].fragty = type;
 }
 
+/* GAS_M68K_OLD set: emulate the gas used for the original builds:
+   keep d16(An) with a zero displacement, use absolute long for
+   forward references instead of relaxing them to PC-relative and
+   accept a short branch to the next instruction.  */
+static int
+old_gas_compat (void)
+{
+  static int v = -1;
+  if (v < 0)
+    v = getenv ("GAS_M68K_OLD") != NULL;
+  return v;
+}
+
 #define isvar(ex) \
   (op (ex) != O_constant && op (ex) != O_big)
 
@@ -2537,6 +2550,7 @@
 		 mode 2 addressing to reduce the instruction size by a
 		 word.  */
 	      if (! isvar (&opP->disp)
+		  && !old_gas_compat ()
 		  && (nextword == 0)
 		  && (opP->disp.size == SIZE_UNSPEC)
 		  && (opP->reg >= ADDR0)
@@ -2901,6 +2915,9 @@
 			 cannot be relaxed.  */
 		      && opP->disp.pic_reloc == pic_none
 		      && !flag_long_jumps
+		      && (!old_gas_compat ()
+			  || (S_IS_DEFINED (adds (&opP->disp))
+			      && S_GET_SEGMENT (adds (&opP->disp)) == now_seg))
 		      && !strchr ("~%&$?", s[0]))
 		    {
 		      tmpreg = 0x3A;	/* 7.2 */
@@ -4889,8 +4906,15 @@
       && (fixP->fx_addsy == NULL
 	  || S_IS_DEFINED (fixP->fx_addsy))
       && (val == 0 || val == -1))
-    as_bad_where (fixP->fx_file, fixP->fx_line,
-		  _("invalid byte branch offset"));
+    {
+      /* The old gas silently emitted the zero offset.  */
+      if (old_gas_compat ())
+	as_warn_where (fixP->fx_file, fixP->fx_line,
+		       _("invalid byte branch offset"));
+      else
+	as_bad_where (fixP->fx_file, fixP->fx_line,
+		      _("invalid byte branch offset"));
+    }
 }
 
