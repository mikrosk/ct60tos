#!/bin/bash
# gas (m68k-elf) used like the MiNT a.out gas of the original builds:
#  - ".align N" is a power of two in a.out -> .p2align N
#  - .text/.data padded with zeros to a multiple of 4, section alignment 4
#  - register names without '%'
P=${GNU_PREFIX:-$(cd "$(dirname "$0")/../install" && pwd)}
args=(); src=; out=a.out; prev=
for a in "$@"; do
	if [ "$prev" = -o ]; then out="$a"; fi
	case "$a" in
		*.s|*.S|-) src="$a";;
		*) args+=("$a");;
	esac
	prev="$a"
done
tmp=$(mktemp --suffix=.s) || exit 1
trap 'rm -f "$tmp"' EXIT
{ if [ -z "$src" ] || [ "$src" = - ]; then cat; else cat "$src"; fi | \
	sed -E 's/^([[:space:]]*)\.align([[:space:]]+)/\1.p2align\2/'
	printf '\n\t.text\n\t.p2align 2,0\n\t.data\n\t.p2align 2,0\n'; } > "$tmp"
"$P/bin/m68k-elf-as" --register-prefix-optional "${args[@]}" "$tmp" || exit 1
"$P/bin/m68k-elf-objcopy" --set-section-alignment .text=4 --set-section-alignment .data=4 "$out"
